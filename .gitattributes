# Cross-platform line-ending policy for RNR-VPN.
#
# This repo is authored primarily on WSL2/Ubuntu but is also opened on Windows
# (see the workspace CLAUDE.md). Without these rules a Windows editor can check
# files out with CRLF, producing noisy whole-file diffs and breaking Mermaid /
# shell / compose parsing. Enforce LF everywhere.

# Default: treat as text, normalise to LF in the repo, check out as LF.
* text=auto eol=lf

# Text files that must always be LF (never CRLF).
*.md        text eol=lf
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.env        text eol=lf
Dockerfile  text eol=lf
.gitignore  text eol=lf

# Binary / generated artifacts - never touch.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.db   binary
*.sqlite binary
